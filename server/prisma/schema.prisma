generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int            @id @default(autoincrement())
  name             String
  email            String         @unique
  password         String
  username         String         @unique
  enrolledCourses  Course[]
  resetToken       String?
  resetTokenExpiry DateTime?
  subscriptions    Subscription[]
}

model Course {
  id             Int            @id @default(autoincrement())
  title          String
  description    String
  price          Float
  offPrice       Float          @map("off_price")
  demoVideoUrl   String         @map("demo_video_link")
  courseVideoUrl String         @map("course_video_link")
  thumbnailUrl   String         @map("thumbnail_url")
  isPublished    Boolean        @default(true)
  subscriptions  Subscription[]
  user           User?          @relation(fields: [userId], references: [id])
  userId         Int?
  Sessions       Sessions[]
}

enum SubscriptionPlanDuration {
  WEEKLY
  MONTHLY
  YEARLY
}

model Subscription {
  id           Int           @id @default(autoincrement())
  userId       Int
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     Int
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  price        Float
  purchaseDate DateTime
  startDate    DateTime
  endDate      DateTime?
  numberOfDays Int
  Cancellation Cancellation?
}

model Sessions {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  sessionTime DateTime @map("session_time")
  sessionLink String   @map("meeting_link")
  courseId    Int
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

enum CancellationEnum {
  PENDING
  APPROVED
}

model Cancellation {
  id               Int              @id @default(autoincrement())
  subscriptionId   Int              @unique
  reason           String
  cancellationDate DateTime         @default(now())
  status           CancellationEnum @default(PENDING)
  subscription     Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model Admin {
  id       Int    @id @default(autoincrement())
  name     String
  username String @unique
  password String
}
